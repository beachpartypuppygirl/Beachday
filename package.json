{
  "name": "beachday",
  "version": "0.1.0",
  "description": "Audio player and playlist curation tool for local music files",
  "author": "beachpartypuppygirl",
  "desktopName": "beachday.desktop",
  "type": "module",
  "main": "src/main/main.mjs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "start:dist": "npm run build && cross-env-shell BEACHDAY_LOAD_DIST=1 electron .",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:win": "npm run build && electron-builder --win",
    "pack:all": "npm run build && electron-builder --linux --win",
    "test": "node tests/run-unit.mjs && node tests/run-e2e.mjs",
    "test:unit": "node tests/run-unit.mjs",
    "test:e2e": "node tests/run-e2e.mjs"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.23",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.5",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "music-metadata": "^12.3.2",
    "omggif": "^1.0.10",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
